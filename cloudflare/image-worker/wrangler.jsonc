{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "storytale-image-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash",
    "GEMINI_IMAGE_MODEL": "gemini-3.1-flash-image",
    // Which image API answers sprite requests. Switching provider or model is
    // this file plus a redeploy: the Flutter app never names a provider, it
    // only reads the X-Image-Provider header off the response.
    //
    // Add "IMAGE_PROVIDER_BY_MODE" as a JSON string to route one mode
    // elsewhere, e.g. {"body-pose":"openai"}, which is the cheap way to compare
    // providers on one part group without moving the rest.
    "IMAGE_PROVIDER": "gemini"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "IMAGE_RATE_LIMIT",
      "namespace_id": "731901",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
